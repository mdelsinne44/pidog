[Unit]
Description=PiDog Monitor - vérification santé au démarrage + état du service robot
After=network-online.target pidog.service
Wants=network-online.target
# Si le service pidog (robot) est absent, le moniteur le signale
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/mdelsinne/pidog/extensions/pidog-monitor/monitor.sh
# Vérification du nouveau service pidog (le robot)
ExecStartPost=/bin/sh -c 'systemctl is-active --quiet pidog.service || echo "[MONITOR] SERVICE PIDOG INACTIF" | logger -t pidog-monitor'
# Vérification de l'agent (stream vocal)
ExecStartPost=/bin/sh -c 'systemctl is-active --quiet pidog-agent.service && echo "[MONITOR] AGENT ACTIF" || echo "[MONITOR] AGENT INACTIF" | logger -t pidog-monitor'
# Si le script échoue → système considère comme failed → relance
Restart=on-failure
RestartSec=30
# WatchdogSec : pas de réponse > 120 s → relance
WatchdogSec=120
Environment=PIDOG_MONITOR_INTERVAL=60
Environment=HEALTH_DELAY=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target