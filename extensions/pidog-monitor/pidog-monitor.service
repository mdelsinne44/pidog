[Unit]
Description=PiDog Monitor — diagnostic santé (boot + périodique)
Documentation=file:///home/mdelsinne/pidog/extensions/pidog-monitor/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mdelsinne
Group=mdelsinne
Environment=MON_BOOT_LOG=/home/mdelsinne/mon-boot.log
Environment=MON_STATE_FILE=/tmp/pidog-monitor.state
ExecStart=/home/mdelsinne/pidog/extensions/pidog-monitor/monitor.sh check
TimeoutStartSec=30
Nice=10
# PAS de Restart= ni de WatchdogSec= ici : sur un Type=oneshot ils provoquent
# une boucle de redémarrage (567 démarrages en 20 h constatés le 02/11) et le
# watchdog est de toute façon ignoré. La périodicité est assurée par
# pidog-monitor.timer ; l'échec est visible via `systemctl --failed`.

[Install]
WantedBy=multi-user.target
