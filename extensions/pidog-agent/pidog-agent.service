[Unit]
Description=PiDog Agent voice stream
After=network-online.target pidog-monitor.service
Wants=network-online.target
Restart=on-failure
RestartSec=10

[Service]
Type=simple
WorkingDirectory=/home/mdelsinne/pidog/extensions/pidog-agent
Environment=LLM_LOCAL_DIR=/home/mdelsinne/models/llm-local
ExecStartPre=/bin/sleep 30
ExecStart=/usr/bin/python3 /home/mdelsinne/pidog/extensions/pidog-agent/voice/assistant_stream.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
