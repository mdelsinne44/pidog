[Unit]
Description=PiDog Agent (cli + voice stream)
After=network-online.target pidog-monitor.service
Wants=network-online.target
Restart=on-failure
RestartSec=10

[Service]
Type=simple
WorkingDirectory=/home/mdelsinne/pidog/extensions/pidog-agent
Environment=LLM_LOCAL_DIR=/home/mdelsinne/models/llm-local
ExecStart=/usr/bin/python3 /home/mdelsinne/pidog/extensions/pidog-agent/cli/pidog_cli.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
