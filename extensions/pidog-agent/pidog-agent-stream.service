[Unit]
Description=PiDog Agent Stream (voix + robot)
# Ne PAS mettre Requires=pidog.service : le daemon peut être lancé
# manuellement/détaché par `pidog start` et n'est alors pas connu de systemd.
# Le stream est un simple client ; il attend que le socket soit prêt.
After=local-fs.target sysinit.target pidog.service

[Service]
Type=simple
User=mdelsinne
Group=mdelsinne
WorkingDirectory=/home/mdelsinne/pidog/extensions/pidog-agent
ExecStart=/usr/bin/python3 /home/mdelsinne/pidog/extensions/pidog-agent/stream/agent_stream.py
Restart=on-failure
RestartSec=5s
KillMode=control-group
Environment=LLM_LOCAL_DIR=/home/mdelsinne/models/llm-local
Environment=PYTHONPATH=/home/mdelsinne/pidog:/home/mdelsinne/pidog/extensions/pidog-agent
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native

[Install]
WantedBy=multi-user.target
