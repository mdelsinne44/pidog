# Copier vers .env et remplir avec vos clés
GROQ_KEY=your_groq_key_here
PIPER_BIN=/home/mdelsinne/.local/bin/piper
VOICE=/home/mdelsinne/pidog/extensions/pidog-agent/models/fr_FR-glados-medium.onnx
MIC_DEV=2
VOSK_MODEL_DIR=/home/mdelsinne/pidog/extensions/pidog-agent/models/vosk-model-small-fr-0.22
# auto = Groq Whisper si GROQ_KEY, sinon Vosk. "vosk" = 100% local.
STT_BACKEND=auto
WHISPER_MODEL=whisper-large-v3-turbo
# Garde-fous servomoteurs (batterie 2x18650)
PIDOG_VOLTAGE_WARN=6.90
PIDOG_VOLTAGE_MIN=6.45
# Locomotion / tête (voir pidog/robot_actions.py)
PIDOG_WALK_SPEED=98
HEAD_LEFT_YAW=30
# Mettre -1 si un jour la gauche/droite physique est inversée (servo remonté)
HEAD_YAW_SIGN=1
HEAD_TURN_SPEED=30

# Outils de l'agent CLI
# readonly  = liste blanche, pas de pipes ni d'écriture (historique)
# workspace = commandes libres dans ~/pidog, destructif refusé (défaut)
# full      = aucune vérification · off = désactivé
PIDOG_SHELL_MODE=workspace
PIDOG_SHELL_TIMEOUT=30
# Répertoires autorisés pour shell/write_file (séparés par des virgules)
PIDOG_WORKSPACE=~/pidog
PIDOG_SHELL_CWD=~/pidog

# ------------------------------------------------------------------ LLM ------
# Chaîne : Groq (référence) → Gemini → OpenRouter gratuit → ALLaM.
# Un fournisseur sans clé est simplement sauté : rien à faire pour désactiver.
# Clés (laisser vide si non utilisée) :
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Tâche par défaut, qui fixe l'ordre et l'échéance : agent (outils),
# voice (latence), cheap (coût), code (contexte). Les appelants passent
# explicitement task=… ; ce réglage sert aux appels qui n'en donnent pas.
PIDOG_LLM_TASK=agent
# Modèle Groq principal et replis (quotas Groq séparés par modèle) :
LLM_MODEL_CLI=qwen/qwen3.8-27b
LLM_FALLBACKS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Fournisseurs incapables de function calling : l'agent les écarte quand il a
# des outils à disposition (sinon ils répondent en prose, sans rien exécuter).
LLM_NO_TOOLS=allam
# Forcer un ordre unique pour toutes les tâches (prioritaire sur TASK_ORDER).
# Par défaut, l'ordre dépend de la tâche : laisser commenté.
# LLM_PROVIDERS=groq,gemini,openrouter,allam
LLM_GEMINI_MODELS=gemini-3.8-flash,gemini-4-argon,gemini-3.5-flash-lite
# ALLaM = 7B servi par Groq (quota distinct), filet de secours en voix
LLM_ALLAM_MODELS=allam-2-7b
LLM_OPENROUTER_MODELS=deepseek/deepseek-v4.1-flash-1017,recursive/flint-v1.0:free,cohere/north-mini-code:free,openrouter/free
# Budget : 800 tokens de sortie max par tour ; résultats d'outils plafonnés.
PIDOG_MAX_TOKENS=800
PIDOG_MAX_TOOL_CHARS=1200

# Optionnel : Kimi K3.1 Pro (gros contexte)
# LLM_KIMI_MODELS=moonshotai/kimi-k3.1-pro
